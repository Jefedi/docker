# Mem0 self-hosted .env template (sovereign EU via LiteLLM + Mistral)
# Generate JWT_SECRET: openssl rand -base64 48

OPENAI_API_KEY=sk-virt-XXXXXXXXXXXXXXXX
# CRITICAL: Must be OPENAI_BASE_URL, NOT OPENAI_API_BASE_URL.
# The openai Python SDK reads OPENAI_BASE_URL. OPENAI_API_BASE_URL is ignored
# and Mem0 will silently fall back to api.openai.com.
OPENAI_BASE_URL=http://litellm:4000/v1

# Postgres — password MUST be "postgres" to match hardcoded alembic.ini
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_COLLECTION_NAME=memories

# Auth — set false for proper API key auth via X-API-Key header
# With true, Mem0 accepts no-auth requests but REJECTS Authorization: *** with API keys
# Create admin + API key via CLI (dashboard fails through remote tunnel):
#   docker exec mem0-dev-mem0-1 sh -c 'python3 -c "..."'
ADMIN_API_KEY=
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_48
AUTH_DISABLED=***
DASHBOARD_URL=http://localhost:3101
APP_DB_NAME=mem0_app

# Models — Mistral via LiteLLM for EU sovereignty
# Mem0 has its own internal LLM (fact extraction) + embedder (vectorization)
# These are SEPARATE from the n8n AI Agent's LLM (GLM-5.2)
#
# CRITICAL: Model names must EXACTLY match LiteLLM's /v1/models endpoint "id" field.
# Verify: curl -s http://localhost:4000/v1/models -H "Authorization: Bearer <key>"
# "mistral-small-latest" is the correct id, NOT "mistral/mistral-small"
#
# For mistral-embed: must be declared in LiteLLM config.yaml as "mistral/mistral-embed"
# so LiteLLM routes to /v1/embeddings (not /v1/chat/completions)
MEM0_DEFAULT_LLM_MODEL=mistral-small-latest
MEM0_DEFAULT_EMBEDDER_MODEL=mistral/mistral-embed

MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30