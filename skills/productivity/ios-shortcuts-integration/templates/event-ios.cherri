#include 'actions/calendar'

/* Event iOS — crée un événement dans l'app Calendrier native
 * Compile avec: cherri event_ios.cherri (dans conteneur Docker cherri-builder)
 *
 * Action definition pour addevent avec paramètre variable:
 * - is.workflow.actions.addevent accepte WFInput (variable) pour le titre
 * - Le raccourci ouvre l'app Calendrier pour confirmer la création
 * - Sync iCloud automatique entre tous les devices
 * - Pour sync via Radicale (CalDAV self-hosted), ajouter un compte CalDAV dans Réglages iOS
 */

#define name "Event iOS"
#define glyph calendar
#define color blue

action 'is.workflow.actions.addevent' addEvent(
    variable input: 'WFInput'
)

@titre = prompt("Titre de l'event :")
@startDate = prompt("Date et heure de debut (ex: 15 aout 2026 14:00) :", "Date and Time")
@duration = prompt("Duree en heures (ex: 2) :", "Number", "1")

addEvent(@titre)

show("Event cree : {@titre}")